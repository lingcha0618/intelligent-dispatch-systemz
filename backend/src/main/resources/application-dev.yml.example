# 配置文件模板
# 使用方法：复制本文件为 application-dev.yml，填入你本机的真实配置
# 注意：application-dev.yml 已被 .gitignore 忽略，不会被提交到仓库

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/campus_dispatch?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: your_username          # 改成你的数据库用户名
    password: your_password          # 改成你的数据库密码
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      maximum-pool-size: 20
      minimum-idle: 5
      connection-timeout: 30000

  data:
    redis:
      host: localhost
      port: 6379
      database: 0
      timeout: 3000
      lettuce:
        pool:
          max-active: 16
          max-idle: 8
          min-idle: 2

  rabbitmq:
    host: localhost
    port: 5672
    username: guest
    password: guest
    publisher-confirm-type: correlated
    publisher-returns: true

  sql:
    init:
      mode: never

logging:
  level:
    com.campus.dispatch: debug
    org.springframework.security: warn
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"
